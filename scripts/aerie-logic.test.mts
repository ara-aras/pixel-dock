import { calculate } from "../src/aerie/lib/calc.ts";
import { convert, formatNumber, unitsOf, CATEGORIES } from "../src/aerie/lib/convert.ts";
let fail = 0;
const eq = (label: string, got: unknown, want: unknown) => { const ok = JSON.stringify(got) === JSON.stringify(want); if (!ok) fail++; console.log(ok ? "ok  " : "FAIL", label.padEnd(30), JSON.stringify(got), ok ? "" : `(want ${JSON.stringify(want)})`); };
eq("15% of 240", calculate("15% of 240"), "36");
eq("sqrt(144)", calculate("sqrt(144)"), "12");
eq("2 plus 3 times 4", calculate("2 plus 3 times 4"), "14");
eq("5 km to miles", calculate("5 km to miles"), "3.10685596119 miles");
eq("10 cm in inches", calculate("10 cm in inches"), "3.93700787402 inches");
eq("empty", calculate(""), null);
eq("garbage", calculate("garbage (("), null);
eq("evaluate blocked", calculate("evaluate('1+1')"), null);
eq("import blocked", calculate("import({a:1})"), null);
eq("createUnit blocked", calculate("createUnit('foo')"), null);
eq("parse blocked", calculate("parse('1+1')"), null);
eq("100 C -> F", convert("Temperature", 100, "°C", "°F"), 212);
eq("0 C -> K", convert("Temperature", 0, "°C", "K"), 273.15);
eq("-40 F -> C", convert("Temperature", -40, "°F", "°C"), -40);
eq("1 mi -> km", convert("Length", 1, "mi", "km"), 1.609344);
eq("1 GiB -> MiB", convert("Data", 1, "GiB", "MiB"), 1024);
eq("1 kg -> lb", formatNumber(convert("Mass", 1, "kg", "lb")), "2.204622622");
eq("60 mph -> km/h", formatNumber(convert("Speed", 60, "mph", "km/h")), "96.56064");
eq("formatNumber 0", formatNumber(0), "0");
eq("formatNumber tiny", formatNumber(1e-9), "1.000000e-9");
eq("formatNumber NaN", formatNumber(NaN), "");
const total = CATEGORIES.reduce((n, c) => n + unitsOf(c).length, 0);
eq("every category has 2+ units", CATEGORIES.every((c) => unitsOf(c).length >= 2), true);
console.log("total units:", total, "categories:", CATEGORIES.length);
console.log(fail ? `${fail} FAILED` : "ALL PASSED"); process.exit(fail ? 1 : 0);
