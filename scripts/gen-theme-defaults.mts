// Regenerates src/aerie/theme/defaults.css: the glass palette as CSS variables,
// applied before React mounts so the first paint matches PILLAR (no colour flash).
// Run: npx tsx scripts/gen-theme-defaults.mts
import { writeFileSync } from "node:fs";
import { cssVariables, glassPalette } from "../src/aerie/theme/palette.ts";

const vars = cssVariables(glassPalette("#EB0028"));
const body = Object.entries(vars)
  .map(([name, value]) => `  ${name}: ${value};`)
  .join("\n");

writeFileSync(
  new URL("../src/aerie/theme/defaults.css", import.meta.url),
  `/* Generated by scripts/gen-theme-defaults.mts. Do not edit by hand. */\n:root {\n${body}\n}\n`,
);
console.log(`wrote ${Object.keys(vars).length} variables`);
