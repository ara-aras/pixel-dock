// Regenerates src/aerie/theme/icons.generated.ts from the ICONS list below.
// Each name needs both "<name>.svg" and "<name>-fill.svg" in @material-symbols/svg-400/rounded;
// a missing icon fails here instead of breaking the app build.
// Run: npx tsx scripts/gen-icons.mts
import { existsSync, writeFileSync } from "node:fs";

const ICONS = [
  "add", "calculate", "close", "content_copy", "content_paste", "delete", "description",
  "folder_open", "graphic_eq", "image", "inventory_2", "keep", "keep_off", "link", "mic",
  "mic_off", "music_note", "notifications", "palette", "search", "settings", "stacks",
  "star_shine", "subtitles", "swap_horiz", "task_alt", "text_snippet", "timer", "videocam",
  // phone link
  "battery_charging_full", "battery_full", "check", "devices", "link_off", "ring_volume", "send", "sync",
].sort();

const base = new URL("../node_modules/@material-symbols/svg-400/rounded/", import.meta.url);
const missing = ICONS.filter((n) => !existsSync(new URL(`${n}.svg`, base)) || !existsSync(new URL(`${n}-fill.svg`, base)));
if (missing.length) {
  console.error(`Missing Material Symbols: ${missing.join(", ")}`);
  process.exit(1);
}

// Prefixed: some icon names are JS reserved words ("delete").
const ident = (n: string) => "icon_" + n.replace(/_([a-z0-9])/g, (_, c: string) => c.toUpperCase());
const lines = [
  "// Generated by scripts/gen-icons.mts. Do not edit by hand.",
  "// Material Symbols (Apache-2.0), Rounded, weight 400, as raw SVG text.",
  ...ICONS.flatMap((n) => [
    `import ${ident(n)} from "@material-symbols/svg-400/rounded/${n}.svg?raw";`,
    `import ${ident(n)}Fill from "@material-symbols/svg-400/rounded/${n}-fill.svg?raw";`,
  ]),
  "",
  "export const ICONS = {",
  ...ICONS.map((n) => `  ${n}: [${ident(n)}, ${ident(n)}Fill],`),
  "} as const;",
  "",
];
writeFileSync(new URL("../src/aerie/theme/icons.generated.ts", import.meta.url), lines.join("\n"));
console.log(`wrote ${ICONS.length} icons`);
